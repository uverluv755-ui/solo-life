{
  "name": "solo-life-reminders",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "APP_ORIGIN": "https://uverluv755-ui.github.io" },
  "durable_objects": { "bindings": [{ "name": "REMINDERS", "class_name": "Reminder" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reminder"] }]
}
